@echo off
setlocal
set "HALLOWEEN_ROOT=%~dp0"
set "HALLOWEEN_NO_BROWSER=0"
if "%~1"=="--no-browser" set "HALLOWEEN_NO_BROWSER=1"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $root=$env:HALLOWEEN_ROOT; $htmlPath=Join-Path $root 'index.html'; $html=[IO.File]::ReadAllBytes($htmlPath); $listener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,0); $listener.Start(); $port=$listener.LocalEndpoint.Port; $url='http://127.0.0.1:'+ $port + '/'; Write-Host ('Halloween Projection 0.1 - '+$url); Write-Host 'Keep this window open. Press Ctrl+C here to stop.'; if($env:HALLOWEEN_NO_BROWSER -ne '1'){Start-Process $url}; try { while($true){$client=$listener.AcceptTcpClient(); try {$client.ReceiveTimeout=5000; $client.SendTimeout=5000; $stream=$client.GetStream(); $reader=[IO.StreamReader]::new($stream,[Text.Encoding]::ASCII,$false,1024,$true); $line=$reader.ReadLine(); $total=0; do {$header=$reader.ReadLine(); $total+=$header.Length; if($total -gt 8192){throw 'Header too large'}} while($header); if($line -match '^GET /( |index.html )'){ $head='HTTP/1.1 200 OK'+[char]13+[char]10+'Content-Type: text/html; charset=utf-8'+[char]13+[char]10+'Content-Length: '+$html.Length+[char]13+[char]10+'Cache-Control: no-store'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10; $buf=[Text.Encoding]::ASCII.GetBytes($head); $stream.Write($buf,0,$buf.Length); $stream.Write($html,0,$html.Length) } else { $buf=[Text.Encoding]::ASCII.GetBytes('HTTP/1.1 404 Not Found'+[char]13+[char]10+'Content-Length: 0'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10); $stream.Write($buf,0,$buf.Length) }; $stream.Flush() } catch { Write-Host 'A local request ended.' } finally { $client.Dispose() } } } finally { $listener.Stop() }"
if errorlevel 1 pause
endlocal
